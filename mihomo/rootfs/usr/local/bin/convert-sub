#!/bin/bash
# ==============================================================================
# convert-sub.sh <url> <out.yaml>
# Скачивает подписку и приводит её к Clash YAML (proxies:).
# Понимает:
#   - готовый Clash YAML (пропускается как есть);
#   - base64-обёрнутый список ссылок (v2ray-подписка);
#   - плоский текстовый список ссылок: vless:// vmess:// trojan:// ss://
#     hysteria2:// (hy2://).
# Выход: YAML-файл с ключом proxies:. Код возврата 0 — есть хотя бы один узел.
# ==============================================================================
set -u
URL="$1"; OUT="$2"

RAW="$(curl -sL --max-time 60 "$URL" 2>/dev/null)" || exit 1
[ -n "${RAW//[[:space:]]/}" ] || exit 1

# --- Уже готовый Clash YAML ---------------------------------------------------
if printf '%s\n' "${RAW}" | grep -qE '^[[:space:]]*proxies:'; then
    printf '%s\n' "${RAW}" > "${OUT}"
    grep -q 'type:' "${OUT}" && exit 0 || exit 1
fi

# --- Целиком base64? (v2ray-подписка) ------------------------------------------
b64d() {
    local s="$1" pad
    s="$(printf '%s' "$s" | tr '_-' '/+' | tr -d '[:space:]')"
    pad=$(( (4 - ${#s} % 4) % 4 ))
    [ "${pad}" -ne 0 ] && s="${s}$(printf '=%.0s' $(seq 1 ${pad}))"
    printf '%s' "${s}" | jq -rj '@base64d' 2>/dev/null
}
DEC="$(b64d "${RAW}")"
SRC="${RAW}"
if printf '%s\n' "${DEC}" 2>/dev/null | grep -qiE '^(vless|vmess|trojan|ss|hysteria2|hy2)[0-9]*://'; then
    SRC="${DEC}"
fi

# --- Разбор ссылок --------------------------------------------------------------
pct() { printf '%b' "${1//%/\\x}"; }            # percent-decode
qget() { # $1=key, $2=query-строка
    local pair
    for pair in ${2//&/ }; do
        [ "${pair%%=*}" = "$1" ] && { printf '%s' "${pair#*=}"; return 0; }
    done
    return 1
}
safe() { printf '%s' "$1" | sed 's/"/'"'"'/g'; }  # кавычки в имени -> одинарные

declare -A SEEN=()
NODE_NUM=0
echo "proxies:" > "${OUT}"

while IFS= read -r line; do
    line="${line//$'\r'/}"
    scheme="${line%%://*}"
    rest="${line#*://}"
    [ "${rest}" = "${line}" ] && continue
    case "${scheme}" in
        vless|trojan|ss|vmess|hysteria2|hy2) ;;
        *) continue ;;
    esac
    [ -n "${rest}" ] || continue

    frag=""; case "${rest}" in *\#*) frag="${rest##*#}"; rest="${rest%%\#*}";; esac
    query=""; case "${rest}" in *\?*) query="${rest#*\?}"; rest="${rest%%\?*}";; esac

    NODE_NUM=$((NODE_NUM + 1))
    NAME="$(pct "${frag}")"
    [ -z "${NAME}" ] && NAME="node-${NODE_NUM}"
    NAME="$(safe "${NAME}")"
    # дубликаты имён недопустимы в mihomo — суффикс #2, #3...
    if [ -n "${SEEN[${NAME}]:-}" ]; then
        SEEN[${NAME}]=$(( SEEN[${NAME}] + 1 ))
        NAME="${NAME} #${SEEN[${NAME}]}"
    else
        SEEN[${NAME}]=1
    fi

    case "${scheme}" in
        vless|trojan|hysteria2|hy2)
            case "${rest}" in
                *@*) userinfo="${rest%%@*}"; hostport="${rest#*@}" ;;
                *) continue ;;
            esac
            host="${hostport%%:*}"; port="${hostport##*:}"
            case "${port}" in ''|*[!0-9]*) continue ;; esac
            case "${scheme}" in
                vless)
                    net="$(qget type "${query}")"; net="${net:-tcp}"
                    flow="$(qget flow "${query}")"
                    sni="$(qget sni "${query}")"; fp="$(qget fp "${query}")"
                    pbk="$(qget pbk "${query}")"; sid="$(qget sid "${query}")"
                    path="$(pct "$(qget path "${query}")")"
                    svc="$(pct "$(qget serviceName "${query}")")"
                    whost="$(pct "$(qget host "${query}")")"
                    {
                        echo "  - name: \"${NAME}\""
                        echo "    type: vless"
                        echo "    server: ${host}"
                        echo "    port: ${port}"
                        echo "    uuid: ${userinfo}"
                        echo "    udp: true"
                        echo "    network: ${net}"
                        if [ -n "${sni}" ] || [ -n "${pbk}" ]; then echo "    tls: true"; fi
                        [ -n "${sni}" ] && echo "    servername: ${sni}"
                        [ -n "${flow}" ] && echo "    flow: ${flow}"
                        [ -n "${fp}" ] && echo "    client-fingerprint: ${fp}"
                        if [ -n "${pbk}" ]; then
                            echo "    reality-opts:"
                            echo "      public-key: ${pbk}"
                            [ -n "${sid}" ] && echo "      short-id: ${sid}"
                        fi
                        case "${net}" in
                            ws)
                                echo "    ws-opts:"
                                [ -n "${path}" ] && echo "      path: ${path}"
                                if [ -n "${whost}" ]; then
                                    echo "      headers:"
                                    echo "        Host: ${whost}"
                                fi
                                ;;
                            grpc)
                                echo "    grpc-opts:"
                                [ -n "${svc}" ] && echo "      grpc-service-name: ${svc}"
                                ;;
                        esac
                    } >> "${OUT}"
                    ;;
                trojan)
                    sni="$(qget sni "${query}")"; fp="$(qget fp "${query}")"
                    {
                        echo "  - name: \"${NAME}\""
                        echo "    type: trojan"
                        echo "    server: ${host}"
                        echo "    port: ${port}"
                        echo "    password: ${userinfo}"
                        echo "    udp: true"
                        [ -n "${sni}" ] && { echo "    sni: ${sni}"; echo "    tls: true"; }
                        [ -n "${fp}" ] && echo "    client-fingerprint: ${fp}"
                    } >> "${OUT}"
                    ;;
                hysteria2|hy2)
                    sni="$(qget sni "${query}")"
                    {
                        echo "  - name: \"${NAME}\""
                        echo "    type: hysteria2"
                        echo "    server: ${host}"
                        echo "    port: ${port}"
                        echo "    password: ${userinfo}"
                        [ -n "${sni}" ] && echo "    sni: ${sni}"
                    } >> "${OUT}"
                    ;;
            esac
            ;;
        ss)
            case "${rest}" in
                *@*)
                    userinfo="${rest%%@*}"; hostport="${rest#*@}"
                    host="${hostport%%:*}"; port="${hostport##*:}"
                    case "${port}" in ''|*[!0-9]*) continue ;; esac
                    mp="$(b64d "${userinfo}")"
                    ;;
                *)
                    dec="$(b64d "${rest}")"
                    case "${dec}" in *@*)
                        mp="${dec%%@*}"; hostport="${dec#*@}"
                        host="${hostport%%:*}"; port="${hostport##*:}"
                        case "${port}" in ''|*[!0-9]*) continue ;; esac
                    ;; *) continue ;; esac
                    ;;
            esac
            [ -n "${mp}" ] || continue
            method="${mp%%:*}"; pass="${mp#*:}"
            {
                echo "  - name: \"${NAME}\""
                echo "    type: ss"
                echo "    server: ${host}"
                echo "    port: ${port}"
                echo "    cipher: ${method}"
                echo "    password: ${pass}"
                echo "    udp: true"
            } >> "${OUT}"
            ;;
        vmess)
            dec="$(b64d "${rest}")"
            J="$(printf '%s' "${dec}" | jq -c . 2>/dev/null)" || continue
            [ -n "${J}" ] || continue
            jget() { printf '%s' "${J}" | jq -rj "$1 // \"\"" 2>/dev/null; }
            vname="$(safe "$(jget '.ps')")"; [ -z "${vname}" ] && vname="${NAME}"
            if [ -n "${SEEN[${vname}]:-}" ]; then
                SEEN[${vname}]=$(( SEEN[${vname}] + 1 )); vname="${vname} #${SEEN[${vname}]}"
            else
                SEEN[${vname}]=1
            fi
            vnet="$(jget '.net')"; vnet="${vnet:-tcp}"
            vtls="$(jget '.tls')"
            vaid="$(jget '.aid')"; vaid="${vaid:-0}"
            vcipher="$(jget '.scy')"; vcipher="${vcipher:-auto}"
            vpath="$(jget '.path')"; vpath="${vpath:-/}"
            vsni="$(jget '.sni')"
            {
                echo "  - name: \"${vname}\""
                echo "    type: vmess"
                echo "    server: $(jget '.add')"
                echo "    port: $(jget '.port')"
                echo "    uuid: $(jget '.id')"
                echo "    alterId: ${vaid}"
                echo "    cipher: ${vcipher}"
                echo "    udp: true"
                echo "    network: ${vnet}"
                [ "${vtls}" = "tls" ] && echo "    tls: true"
                [ -n "${vsni}" ] && [ "${vtls}" = "tls" ] && echo "    servername: ${vsni}"
                [ "${vnet}" = "ws" ] && { echo "    ws-opts:"; echo "      path: ${vpath}"; }
            } >> "${OUT}"
            ;;
    esac
done <<< "${SRC}"

grep -q 'type:' "${OUT}"
