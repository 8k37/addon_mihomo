#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash
# ==============================================================================
# Тест скорости и автоподбор самого быстрого узла.
#
# Схема выбора: PROXY -> FASTEST -> AUTO -> узел
#   1. Штатный health-check провайдеров (раз в 30 мин) держит пинг-историю узлов.
#   2. Каждые INTERVAL мин: пинг-фильтр -> замер скорости живых (окно MAX_NODES).
#   3. Топ-10 по скорости записывается в состав AUTO (url-test) и FASTEST,
#      конфиг горячо перезагружается через API; AUTO выбирает быстрейшего.
#   4. Монитор каждые 30 с: проверка stale-выбора AUTO (после reload из
#      cache.db может вернуться узел вне топа — сразу перевыбираем) и живости
#      текущего узла (умер — внеочередной цикл).
# Замеры идут через скрытую группу SPEEDTEST и listener 7899 — основной
# трафик не страдает.
# ==============================================================================
CONFIG_FILE="$(bashio::config 'config_file' '/share/mihomo/config.yaml')"
CONFIG_DIR="$(dirname "${CONFIG_FILE}")"
INTERVAL_MIN="$(bashio::config 'speedtest_interval' '30')"
MAX_NODES="$(bashio::config 'speedtest_max_nodes' '50')"
TEST_URL="$(bashio::config 'speedtest_url' 'https://speed.cloudflare.com/__down?bytes=10000000')"
API="http://127.0.0.1:9090"
OFFSET_FILE="${CONFIG_DIR}/providers/.speedtest_offset"
PING_URL_ENC="$(jq -rn --arg u "$(bashio::config 'healthcheck_url' 'https://www.gstatic.com/generate_204')" '$u | @uri')"

SECRET="$(yq '.secret // ""' "${CONFIG_FILE}" 2>/dev/null || echo "")"
if [ -n "${SECRET}" ]; then
    AUTH=(-H "Authorization: Bearer ${SECRET}")
else
    AUTH=()
fi

count() {
    printf '%s\n' "$1" | grep -c . || true
}

api() {
    curl -sf --max-time 10 "${AUTH[@]}" "$@" 2>/dev/null
}

# Переключить группу $1 на узел $2
select_group() {
    local body
    body="$(jq -n --arg n "$2" '{name: $n}')"
    api -X PUT -H "Content-Type: application/json" "${API}/proxies/$1" -d "${body}" >/dev/null 2>&1
}

get_nodes() {
    api "${API}/proxies/SPEEDTEST" | jq -r '.all // [] | .[]' | grep -vE '^(DIRECT|REJECT)$' || true
}

alive_list() {
    # Узлы подписок НЕ отображаются в /proxies (там только группы) —
    # источник пинг-истории: /providers/proxies
    api "${API}/providers/proxies" | jq -r \
        '.providers // {} | to_entries[] | .value.proxies[]? | select((.history // [] | length) > 0 and (.history[-1].delay // 0) > 0) | .name' \
        | sort -u || true
}

# Пинг конкретного узла штатным механизмом ядра (5 сек); 0 = не отвечает
node_delay() {
    local enc delay prov p_enc
    enc="$(jq -rn --arg n "$1" '$n | @uri')"
    delay="$(api "${API}/proxies/${enc}/delay?timeout=5000&url=${PING_URL_ENC}" | jq -r '.delay // 0' || echo 0)"
    delay="$(printf '%s' "${delay}" | tr -d '[:space:]')"
    case "${delay}" in
        ""|*[!0-9]*) delay=0 ;;
    esac
    if [ "${delay}" -gt 0 ]; then
        printf '%s' "${delay}"
        return 0
    fi
    # Узел провайдера: в /proxies его нет — дёргаем одиночный healthcheck
    # провайдера и читаем свежую пинг-историю
    prov="$(api "${API}/providers/proxies" | jq -r --arg n "$1" \
        '.providers // {} | to_entries[] | select(any(.value.proxies[]?; .name == $n)) | .key' \
        | head -n1 || true)"
    [ -z "${prov}" ] && { printf '0'; return 0; }
    p_enc="$(jq -rn --arg p "${prov}" '$p | @uri')"
    api "${API}/providers/proxies/${p_enc}/${enc}/healthcheck?url=${PING_URL_ENC}&timeout=5000" >/dev/null 2>&1 || true
    delay="$(api "${API}/providers/proxies/${p_enc}" | jq -r --arg n "$1" \
        '.proxies // [] | map(select(.name == $n)) | .[0].history // [] | if length > 0 then (.[-1].delay // 0) else 0 end' \
        || echo 0)"
    delay="$(printf '%s' "${delay}" | tr -d '[:space:]')"
    case "${delay}" in
        ""|*[!0-9]*) delay=0 ;;
    esac
    printf '%s' "${delay}"
}

MODE="$(bashio::config 'mode' 'global')"

# Валидация: закэшированный выбранный узел мог исчезнуть из подписки.
# Если .now отсутствует в .all — выбираем первый живой (или просто первый) узел.
fix_stale_selection() {
    local grp="$1" now all cand alive
    now="$(api "${API}/proxies/${grp}" | jq -r '.now // ""' || true)"
    [ -z "${now}" ] && return 0
    all="$(api "${API}/proxies/${grp}" | jq -r '.all // [] | .[]' || true)"
    if [ -n "${all}" ] && ! printf '%s\n' "${all}" | grep -Fqx -- "${now}"; then
        bashio::log.warning "Группа ${grp}: закэшированный узел [${now}] отсутствует в списке — перевыбираю."
        alive="$(alive_list)"
        # 1) лучший по последнему замеру, 2) первый живой, 3) просто первый
        cand=""
        if [ -f "${CONFIG_DIR}/speedtest-results.txt" ]; then
            cand="$(grep -v '^#' "${CONFIG_DIR}/speedtest-results.txt" 2>/dev/null \
                | sed 's/^.*Мбит\/с  //' | grep -Fxf <(printf '%s\n' "${all}") | head -n1 || true)"
        fi
        if [ -z "${cand}" ]; then
            cand="$(printf '%s\n' "${all}" | grep -Fxf <(printf '%s\n' "${alive}") | head -n1 || true)"
        fi
        if [ -z "${cand}" ]; then
            cand="$(printf '%s\n' "${all}" | grep -vE '^(DIRECT|REJECT)$' | head -n1 || true)"
        fi
        if [ -n "${cand}" ]; then
            select_group "${grp}" "${cand}"
            bashio::log.info "Группа ${grp}: выбран [${cand}]."
        fi
    fi
}

# Состояние применения топ-10 (переживает циклы в рамках работы службы)
LAST_TOP=""          # последний применённый топ (JSON)
APPLIED_BEST=""      # применённый лучший узел
APPLIED_SPEED=0      # его скорость, Мбит/с
if [ -f "${CONFIG_DIR}/speedtest-results.txt" ]; then
    _line="$(grep -v '^#' "${CONFIG_DIR}/speedtest-results.txt" 2>/dev/null | head -n1 || true)"
    if [ -n "${_line}" ]; then
        APPLIED_BEST="$(printf '%s' "${_line}" | sed 's/^.*Мбит\/с  //')"
        APPLIED_SPEED="$(printf '%s' "${_line}" | awk '{print $1}')"
        case "${APPLIED_SPEED}" in ""|*[!0-9.]*) APPLIED_SPEED=0 ;; esac
    fi
fi

# Топ-10 (или меньше, если узлов меньше) из сырых результатов
# "скорость|узел" -> JSON-массив имён
top_of() {
    printf '%s\n' "$1" | sort -t'|' -k1,1rn | head -n 10 | cut -d'|' -f2 \
        | jq -Rsc 'split("\n") | map(select(length > 0))'
}

# Применить топ: записать в конфиг, горячо перезагрузить ядро, вернуть цепочку
apply_top() {
    local top_json="$1" top_first
    yq -i --argjson t "${top_json}" \
        '(.proxy-groups[] | select(.name == "AUTO") | .proxies) = $t |
         (.proxy-groups[] | select(.name == "AUTO") | .include-all) = false |
         (.proxy-groups[] | select(.name == "FASTEST") | .proxies) = (["AUTO"] + $t) |
         (.proxy-groups[] | select(.name == "FASTEST") | .include-all) = false' \
        "${CONFIG_FILE}"
    if ! api -X PUT -H "Content-Type: application/json" "${API}/configs?force=true" \
            -d '{"path": ""}' >/dev/null 2>&1; then
        bashio::log.warning "Не удалось перезагрузить конфиг — топ применится при рестарте аддона."
        return 1
    fi
    sleep 2
    # После перезагрузки ядро восстанавливает выборы из cache.db, где AUTO может
    # указывать на узел из старого топа — задираем заново на лучший узел
    top_first="$(printf '%s' "${top_json}" | jq -r '.[0]')"
    select_group "AUTO" "${top_first}"
    if [ "${MODE}" = "global" ]; then select_group "GLOBAL" "FASTEST"; fi
    select_group "PROXY" "FASTEST"
    select_group "FASTEST" "AUTO"
    LAST_TOP="${top_json}"
    APPLIED_BEST="${top_first}"
    bashio::log.info "Топ применён ($(printf '%s' "${top_json}" | jq 'length') узлов), AUTO -> [${top_first}]: $(printf '%s' "${top_json}" | jq -r 'join(" | ")')"
    return 0
}

if [ "${INTERVAL_MIN}" -le 0 ]; then
    bashio::log.info "Тест скорости отключен (speedtest_interval=0)."
    while true; do sleep 3600; done
fi
INTERVAL=$((INTERVAL_MIN * 60))

# Ждём готовности API (максимум ~5 минут)
i=0
until api "${API}/version" >/dev/null 2>&1; do
    i=$((i + 1))
    if [ "${i}" -gt 60 ]; then
        bashio::log.warning "API mihomo недоступен — тест скорости не запущен."
        while true; do sleep 3600; done
    fi
    sleep 5
done

# Прогреваем health-check провайдеров — чтобы пинг-история узлов появилась
# сразу после старта, а не через полчаса (интервал штатной проверки 1800 с)
for p in $(api "${API}/providers/proxies" | jq -r '.providers // {} | keys[]' | grep -vE '^(default|compatible)$' || true); do
    p_enc="$(jq -rn --arg n "${p}" '$n | @uri')"
    api "${API}/providers/proxies/${p_enc}/healthcheck" >/dev/null 2>&1 || true
done

# Валидация кэшированных выборов и настройка глобального режима
# (AUTO первым: FASTEST -> AUTO должен указывать на живой узел)
fix_stale_selection "AUTO"
fix_stale_selection "FASTEST"
fix_stale_selection "PROXY"
if [ "${MODE}" = "global" ]; then
    # В глобальном режиме весь трафик идёт через встроенную группу GLOBAL —
    # по умолчанию направляем её на FASTEST (иначе там DIRECT: трафик мимо VPN)
    GNOW="$(api "${API}/proxies/GLOBAL" | jq -r '.now // ""' || true)"
    if [ "${GNOW}" != "FASTEST" ]; then
        select_group "GLOBAL" "FASTEST"
        bashio::log.info "GLOBAL -> FASTEST (глобальный режим)."
    fi
fi
bashio::log.info "Служба speedtest запущена (интервал ${INTERVAL_MIN} мин)."

# Форс-обновление подписок (Clash http-провайдеров) через API перед циклом —
# штатный интервал ядра 6 часов, так список узлов всегда свежий
update_subscriptions() {
    local p p_enc code
    for p in $(api "${API}/providers/proxies" | jq -r \
        '.providers // {} | to_entries[] | select(.value.vehicleType == "HTTP") | .key' \
        | sort -V || true); do
        p_enc="$(jq -rn --arg x "${p}" '$x | @uri')"
        code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 60 \
            -X PUT "${AUTH[@]}" "${API}/providers/proxies/${p_enc}" 2>/dev/null || echo 0)"
        if [ "${code}" = "204" ]; then
            bashio::log.info "Подписка ${p} обновлена."
        else
            bashio::log.warning "Подписка ${p}: не удалось обновить (HTTP ${code})."
        fi
    done
}

# Полный цикл: обновление подписок -> пинг-фильтр -> замер скорости -> топ
# Аргумент "scheduled" — плановый запуск (с обновлением подписок), иначе быстрый
run_cycle() {
    local MODE_CYCLE="${1:-quick}"
    local all_nodes nodes_n alive candidates cand_n
    if [ "${MODE_CYCLE}" = "scheduled" ]; then
        update_subscriptions
        sleep 2
    fi
    all_nodes="$(get_nodes)"
    if [ -z "${all_nodes}" ]; then
        bashio::log.warning "Speedtest: нет доступных узлов (группа FASTEST пуста или API не ответил)."
        return 1
    fi
    nodes_n="$(count "${all_nodes}")"

    alive="$(alive_list)"
    if [ -n "${alive}" ]; then
        candidates="$(printf '%s\n' "${all_nodes}" | grep -Fxf <(printf '%s\n' "${alive}") || true)"
        cand_n="$(count "${candidates}")"
        if [ "${cand_n}" -eq 0 ]; then
            bashio::log.warning "Speedtest: штатный пинг не прошёл ни у одного из ${nodes_n} — тестирую скорость напрямую."
            candidates="${all_nodes}"
        else
            bashio::log.info "Speedtest: живых по штатному пингу ${cand_n} из ${nodes_n}."
        fi
    else
        bashio::log.info "Speedtest: нет данных штатного health-check — быстрый пинг-проход..."
        candidates=""
        local pinged=0 node delay
        while IFS= read -r node; do
            [ -z "${node}" ] && continue
            pinged=$((pinged + 1))
            if [ "${MAX_NODES}" -gt 0 ] && [ "${pinged}" -gt "${MAX_NODES}" ]; then break; fi
            delay="$(node_delay "${node}")"
            if awk "BEGIN{exit !(${delay:-0} > 0)}"; then
                candidates+="${node}"$'\n'
            fi
        done <<< "${all_nodes}"
        cand_n="$(count "${candidates}")"
        if [ "${cand_n}" -eq 0 ]; then
            # Пинг может врать (например, проверочный URL недоступен) — не
            # бросаем цикл: скорость сама покажет живых (мёртвые дадут 0)
            bashio::log.warning "Speedtest: пинг не прошёл ни у одного из ${pinged} — тестирую скорость напрямую."
            candidates="${all_nodes}"
        else
            bashio::log.info "Speedtest: пинг прошли ${cand_n} из ${pinged} проверенных."
        fi
    fi

    # Окно кандидатов с ротацией между циклами
    mapfile -t cand_arr <<< "${candidates}"
    local total="${#cand_arr[@]}"
    local to_test
    if [ "${MAX_NODES}" -gt 0 ] && [ "${total}" -gt "${MAX_NODES}" ]; then
        local offset
        offset="$(cat "${OFFSET_FILE}" 2>/dev/null || echo 0)"
        [ "${offset}" -ge "${total}" ] && offset=0
        to_test="$(printf '%s\n' "${cand_arr[@]}" | sed -n "$((offset + 1)),$((offset + MAX_NODES))p")"
        offset=$(( (offset + MAX_NODES) % total ))
        echo "${offset}" > "${OFFSET_FILE}"
        bashio::log.info "Speedtest: тестирую скорость ${MAX_NODES} из ${total} живых (окно с ${offset})."
    else
        to_test="${candidates}"
        bashio::log.info "Speedtest: тестирую скорость ${total} узлов."
    fi

    local results="" node speed mbps
    while IFS= read -r node; do
        [ -z "${node}" ] && continue
        if ! select_group "SPEEDTEST" "${node}"; then
            bashio::log.warning "Speedtest: не удалось выбрать узел [${node}] — пропускаю."
            continue
        fi
        speed="$(curl -x 'http://127.0.0.1:7899' -sS -o /dev/null --connect-timeout 5 --max-time 15 \
            -w '%{speed_download}' "${TEST_URL}" 2>/dev/null || echo 0)"
        speed="$(printf '%s' "${speed}" | tr -d '[:space:]')"
        case "${speed}" in
            ""|*[!0-9.]*) speed=0 ;;
        esac
        mbps="$(awk "BEGIN{printf \"%.1f\", ${speed} * 8 / 1000000}")"
        bashio::log.info "Скорость [${node}]: ${mbps} Мбит/с"
        results+="${mbps}|${node}"$'\n'

        # Переключение сразу: узел с пингом (живой) показал скорость выше
        # применённого лучшего — не ждём конца цикла, применяем топ сейчас
        if awk "BEGIN{exit !(${mbps} > ${APPLIED_SPEED})}"; then
            top_now="$(top_of "${results}")"
            if [ -n "${top_now}" ] && [ "${top_now}" != "[]" ]; then
                if apply_top "${top_now}"; then
                    APPLIED_SPEED="${mbps}"
                fi
            fi
        fi
    done <<< "${to_test}"

    # Файл результатов — доступен по Samba: \\homeassistant\share\mihomo\
    if [ -n "${results}" ]; then
        {
            echo "# Замер: $(date '+%Y-%m-%d %H:%M:%S'), узлов: $(count "${results}"), файл: ${TEST_URL}"
            printf '%s\n' "${results}" | sort -t'|' -k1,1rn | awk -F'|' '{printf "%8.1f Мбит/с  %s\n", $1, $2}'
        } > "${CONFIG_DIR}/speedtest-results.txt"
    fi

    # Финал цикла: если топ в итоге отличается от применённого — применяем
    # (например, середина топа поменялась без смены лидера)
    if [ -n "${results}" ]; then
        top_json="$(top_of "${results}")"
        if [ -n "${top_json}" ] && [ "${top_json}" != "[]" ] && [ "${top_json}" != "${LAST_TOP}" ]; then
            apply_top "${top_json}" || true
        fi
    fi
    return 0
}

# Первый цикл сразу (с обновлением подписок)
run_cycle scheduled || true

# Основной цикл: каждую минуту проверяем stale-выбор AUTO и живость текущего
# узла; проблема — сразу чиним/внеочередной цикл. Раз в INTERVAL — полный замер.
LAST_CYCLE=0
while true; do
    sleep 30
    NOW_TS="$(date +%s)"
    if [ "$((NOW_TS - LAST_CYCLE))" -ge "${INTERVAL}" ]; then
        run_cycle scheduled || true
        LAST_CYCLE="$(date +%s)"
        continue
    fi
    NOW_NODE="$(api "${API}/proxies/AUTO" | jq -r '.now // ""' || true)"
    [ -z "${NOW_NODE}" ] && continue

    # Контроль: после обновления топа (hot-reload) ядро могло восстановить из
    # cache.db выбор AUTO на узел, которого уже нет в списке. Сразу чиним.
    ALL_NOW="$(api "${API}/proxies/AUTO" | jq -r '.all // [] | .[]' || true)"
    if [ -n "${ALL_NOW}" ] && ! printf '%s\n' "${ALL_NOW}" | grep -Fqx -- "${NOW_NODE}"; then
        bashio::log.warning "AUTO указывает на узел [${NOW_NODE}], которого нет в списке — перевыбираю."
        # Лучший по последнему замеру из актуального списка AUTO, иначе первый живой
        FIX=""
        if [ -f "${CONFIG_DIR}/speedtest-results.txt" ]; then
            FIX="$(grep -v '^#' "${CONFIG_DIR}/speedtest-results.txt" 2>/dev/null \
                | sed 's/^.*Мбит\/с  //' | grep -Fxf <(printf '%s\n' "${ALL_NOW}") | head -n1 || true)"
        fi
        if [ -z "${FIX}" ]; then
            FIX="$(printf '%s\n' "${ALL_NOW}" | head -n1 || true)"
        fi
        if [ -n "${FIX}" ]; then
            select_group "AUTO" "${FIX}"
            bashio::log.info "AUTO -> [${FIX}]."
        fi
        continue
    fi

    DELAY="$(node_delay "${NOW_NODE}")"
    if ! awk "BEGIN{exit !(${DELAY:-0} > 0)}"; then
        # Если совсем недавно подбор уже не нашёл живых — не спамим, ждём
        if [ "$((NOW_TS - LAST_CYCLE))" -lt 180 ]; then
            continue
        fi
        bashio::log.warning "Текущий узел [${NOW_NODE}] не отвечает — внеочередной подбор."
        run_cycle || true
        LAST_CYCLE="$(date +%s)"
    fi
done
