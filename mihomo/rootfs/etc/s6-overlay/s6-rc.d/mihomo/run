#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash
set -e

CONFIG_FILE="$(bashio::config 'config_file' '/share/mihomo/config.yaml')"
CONFIG_DIR="$(dirname "${CONFIG_FILE}")"

mkdir -p "${CONFIG_DIR}"

# При первом запуске создаём конфиг по умолчанию
if [ ! -f "${CONFIG_FILE}" ]; then
    bashio::log.info "Конфиг не найден, создаю ${CONFIG_FILE}..."
    cp /etc/mihomo/config.yaml.default "${CONFIG_FILE}"
    bashio::log.warning "Отредактируйте ${CONFIG_FILE} (добавьте свои прокси) и перезапустите аддон."
fi

# Панель metacubexd: распаковываем в подпапку конфиг-директории
# (mihomo разрешает external-ui только внутри home-директории)
UI_DIR="${CONFIG_DIR}/ui"
if [ ! -f "${UI_DIR}/index.html" ]; then
    bashio::log.info "Устанавливаю веб-панель metacubexd в ${UI_DIR}..."
    mkdir -p "${UI_DIR}"
    cp -r /usr/share/mihomo/ui/. "${UI_DIR}/"
fi

# external-ui должен указывать на подпапку home-директории
if grep -q '^external-ui:' "${CONFIG_FILE}"; then
    sed -i 's|^external-ui:.*|external-ui: ui|' "${CONFIG_FILE}"
else
    printf '\nexternal-ui: ui\n' >> "${CONFIG_FILE}"
    bashio::log.info "В конфиг добавлен external-ui. Панель: http://<ip-хоста>:9090/ui"
fi

# Контроллер обязан слушать на 0.0.0.0, иначе Ingress HA не сможет подключиться (502)
if grep -qE '^external-controller:.*127\.0\.0\.1' "${CONFIG_FILE}"; then
    CTRL_PORT="$(grep -E '^external-controller:' "${CONFIG_FILE}" | grep -oE '[0-9]+$')"
    sed -i "s|^external-controller:.*|external-controller: 0.0.0.0:${CTRL_PORT:-9090}|" "${CONFIG_FILE}"
    bashio::log.warning "external-controller был привязан к 127.0.0.1 — исправлено на 0.0.0.0 (для Ingress)."
fi

bashio::log.info "Запуск mihomo с конфигом: ${CONFIG_FILE}"
exec mihomo -d "${CONFIG_DIR}" -f "${CONFIG_FILE}"
