# Базовый конфиг mihomo (Clash Meta)
# Полная документация: https://wiki.metacubex.one/

mixed-port: 7890        # HTTP + SOCKS5 на одном порту
socks-port: 7891
allow-lan: true         # доступ из локальной сети
bind-address: "*"
mode: rule
log-level: info
external-controller: 0.0.0.0:9090   # Web UI / API
external-ui: ui   # встроенная панель metacubexd: http://<ip>:9090/ui
# secret: "password"    # пароль для панели (рекомендуется задать!)

# Здесь укажите свои прокси-серверы
proxies: []
#  - name: "my-proxy"
#    type: ss
#    server: server.example.com
#    port: 443
#    cipher: aes-256-gcm
#    password: "secret"

proxy-groups: []

rules:
  - MATCH,DIRECT
